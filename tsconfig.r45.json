{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true
  },
  "include": [
    "src/engine-ts/r45/**/*.ts",
    "tests/engine-r45/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage"]
}
