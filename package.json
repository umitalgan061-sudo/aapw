
{
  "name": "aapw",
  "private": true,
  "version": "1.0.0-modernization",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:modern": "vite build",
    "check": "npm run typecheck && npm test -- --passWithNoTests",
    "verify:modern": "node scripts/checkModernPlatform.mjs",
    "verify:runtime-r41": "node --experimental-strip-types scripts/checkRuntimeR41Architecture.ts",
    "verify:typescript-ownership-r41": "node --experimental-strip-types scripts/checkTypeScriptOwnershipR41.ts",
    "typecheck:runtime-r41": "tsc -p tsconfig.runtime-r41.json --noEmit",
    "test:runtime-r41": "vitest run tests/modern/r41*.test.ts --passWithNoTests",
    "check:runtime-r41": "npm run verify:runtime-r41 && npm run verify:typescript-ownership-r41 && npm run typecheck:runtime-r41 && npm run test:runtime-r41"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
