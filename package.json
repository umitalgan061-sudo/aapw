{
  "name": "aapw",
  "private": true,
  "version": "1.1.0-modern-runtime",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:modern": "vite build",
    "check": "npm run verify:modern && npm run verify:application && npm run typecheck && npm test -- --passWithNoTests",
    "verify:modern": "node scripts/checkModernPlatform.mjs",
    "verify:application": "node scripts/checkModernApplicationRuntime.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
