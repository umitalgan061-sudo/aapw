{
  "name": "aapw",
  "private": true,
  "version": "1.0.0-modernization",
  "type": "module",
  "engines": {"node": ">=24.21.0"},
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:modern": "vite build",
    "check": "npm run typecheck && npm test -- --passWithNoTests",
    "verify:modern": "node scripts/checkModernPlatform.mjs",
    "verify:modern:v3": "node scripts/checkModernPlatformV3.mjs",
    "verify:typed": "node scripts/checkTypedArchitecture.mjs",
    "test:typed": "node --experimental-strip-types scripts/checkTypedEngine.mjs",
    "verify:modern:v2": "node scripts/checkModernRuntimeIntegrationV2.mjs",
    "verify:modern:v5": "node scripts/checkCompleteTypeScriptPlatformV5.mjs",
    "verify:all-modern": "npm run verify:modern && npm run verify:modern:v3 && npm run verify:typed && npm run test:typed && npm run verify:modern:v2 && npm run verify:modern:v5",
    "verify:nextgen": "node scripts/checkNextGenRuntimeV2.mjs",
    "check:nextgen": "npm run verify:nextgen && npm run typecheck && npm test -- --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
