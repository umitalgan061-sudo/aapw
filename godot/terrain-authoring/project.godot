
; Westeros HTerrain authoring project.
; The initial blank line is intentionally preserved from the owner-created placeholder.
config_version=5

[application]

config/name="Westeros Terrain Authoring"
run/main_scene="res://scenes/westeros_terrain_authoring.tscn"
config/features=PackedStringArray("4.6")

[editor_plugins]

enabled=PackedStringArray("res://addons/zylann.hterrain/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
